{
  "type": "object",
  "additionalProperties": false,
  "required": ["normalizedRequirement", "evidence", "moduleCandidates", "a2aContracts", "processFlow"],
  "properties": {
    "normalizedRequirement": {
      "$ref": "#/$defs/normalizedRequirement"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "moduleCandidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/moduleCandidate"
      }
    },
    "a2aContracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/a2aContract"
      }
    },
    "processFlow": {
      "$ref": "#/$defs/processFlow"
    }
  },
  "$defs": {
    "nullableString": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "nullableBoolean": {
      "anyOf": [{ "type": "boolean" }, { "type": "null" }]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "required": { "type": "boolean" }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "access"],
      "properties": {
        "name": { "type": "string" },
        "access": {
          "type": "string",
          "enum": ["unknown", "read", "write", "read_write", "not_required"]
        }
      }
    },
    "adkHints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_memory",
        "callbacks",
        "artifacts_events",
        "mcp_a2a",
        "streaming_grounding"
      ],
      "properties": {
        "state_memory": { "$ref": "#/$defs/nullableString" },
        "callbacks": { "$ref": "#/$defs/nullableString" },
        "artifacts_events": { "$ref": "#/$defs/nullableString" },
        "mcp_a2a": { "$ref": "#/$defs/nullableString" },
        "streaming_grounding": { "$ref": "#/$defs/nullableString" }
      }
    },
    "riskSignal": {
      "type": "string",
      "enum": [
        "personal_data",
        "financial_data",
        "credit_decision_support",
        "customer_impact",
        "external_message",
        "transaction_write",
        "human_approval_required",
        "audit_required"
      ]
    },
    "normalizedRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "raw_text",
        "domain",
        "requester",
        "business_goal",
        "current_process",
        "inputs",
        "outputs",
        "systems",
        "risk_signals",
        "missing_information",
        "contradictions",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^req-[a-z0-9-]+$" },
        "title": { "type": "string" },
        "raw_text": { "type": "string" },
        "domain": { "type": "string" },
        "requester": {
          "type": "object",
          "additionalProperties": false,
          "required": ["team", "role"],
          "properties": {
            "team": { "type": "string" },
            "role": { "type": "string" }
          }
        },
        "business_goal": { "type": "string" },
        "current_process": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "systems": {
          "type": "array",
          "items": { "$ref": "#/$defs/system" }
        },
        "risk_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/riskSignal" }
        },
        "missing_information": {
          "type": "array",
          "items": { "type": "string" }
        },
        "contradictions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": ["draft", "reviewed", "approved", "rejected"]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_goal",
        "business_domain_hint",
        "user_role",
        "input_data",
        "output_data",
        "systems_mentioned",
        "decisions_implied",
        "risk_signals",
        "missing_information",
        "contradictions",
        "assumptions"
      ],
      "properties": {
        "requested_goal": { "type": "string" },
        "business_domain_hint": { "type": "string" },
        "user_role": { "type": "string" },
        "input_data": {
          "type": "array",
          "items": { "type": "string" }
        },
        "output_data": {
          "type": "array",
          "items": { "type": "string" }
        },
        "systems_mentioned": {
          "type": "array",
          "items": { "type": "string" }
        },
        "decisions_implied": {
          "type": "array",
          "items": { "type": "string" }
        },
        "risk_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/riskSignal" }
        },
        "missing_information": {
          "type": "array",
          "items": { "type": "string" }
        },
        "contradictions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "moduleCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_requirement_id",
        "name",
        "module_category",
        "agent_kind",
        "workflow_kind",
        "adapter_kind",
        "remote_contract_kind",
        "legacy_recommended_type",
        "confidence",
        "rationale",
        "adk_hints",
        "inputs",
        "outputs",
        "reuse_candidate",
        "risk_level",
        "risk_signals",
        "status",
        "missing_information",
        "side_effect",
        "auth_required",
        "audit_required",
        "citation_required",
        "grounding_required",
        "source_acl_required",
        "versioned",
        "effective_date_required",
        "owner_domain",
        "owner",
        "agent_card",
        "auth",
        "task_lifecycle",
        "timeout",
        "retry",
        "fallback",
        "audit",
        "data_policy",
        "a2a_contract_id"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^mod-[a-z0-9-]+$" },
        "source_requirement_id": { "type": "string", "pattern": "^req-[a-z0-9-]+$" },
        "name": { "type": "string" },
        "module_category": {
          "type": "string",
          "enum": ["agent", "workflow", "adapter", "remote_a2a"]
        },
        "agent_kind": {
          "anyOf": [{ "type": "string", "enum": ["specialist", "shared"] }, { "type": "null" }]
        },
        "workflow_kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "sequential",
                "parallel",
                "loop",
                "human_review",
                "orchestration",
                "graph",
                "dynamic",
                "unknown"
              ]
            },
            { "type": "null" }
          ]
        },
        "adapter_kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "legacy_api",
                "retrieval",
                "rule_registry",
                "data_query",
                "template",
                "computation",
                "external_service",
                "unknown"
              ]
            },
            { "type": "null" }
          ]
        },
        "remote_contract_kind": {
          "anyOf": [{ "type": "string", "enum": ["a2a", "unknown"] }, { "type": "null" }]
        },
        "legacy_recommended_type": { "$ref": "#/$defs/nullableString" },
        "confidence": { "type": "number" },
        "rationale": { "type": "string" },
        "adk_hints": {
          "anyOf": [{ "$ref": "#/$defs/adkHints" }, { "type": "null" }]
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "reuse_candidate": { "type": "boolean" },
        "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
        "risk_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/riskSignal" }
        },
        "status": {
          "type": "string",
          "enum": ["needs_info", "deferred", "rejected"]
        },
        "missing_information": {
          "type": "array",
          "items": { "type": "string" }
        },
        "side_effect": {
          "anyOf": [
            { "type": "string", "enum": ["none", "read", "write", "read_write", "unknown"] },
            { "type": "null" }
          ]
        },
        "auth_required": { "$ref": "#/$defs/nullableBoolean" },
        "audit_required": { "$ref": "#/$defs/nullableBoolean" },
        "citation_required": { "$ref": "#/$defs/nullableBoolean" },
        "grounding_required": { "$ref": "#/$defs/nullableBoolean" },
        "source_acl_required": { "$ref": "#/$defs/nullableBoolean" },
        "versioned": { "$ref": "#/$defs/nullableBoolean" },
        "effective_date_required": { "$ref": "#/$defs/nullableBoolean" },
        "owner_domain": { "$ref": "#/$defs/nullableString" },
        "owner": { "$ref": "#/$defs/nullableString" },
        "agent_card": { "$ref": "#/$defs/nullableString" },
        "auth": { "$ref": "#/$defs/nullableString" },
        "task_lifecycle": { "$ref": "#/$defs/nullableString" },
        "timeout": { "$ref": "#/$defs/nullableString" },
        "retry": { "$ref": "#/$defs/nullableString" },
        "fallback": { "$ref": "#/$defs/nullableString" },
        "audit": { "$ref": "#/$defs/nullableString" },
        "data_policy": { "$ref": "#/$defs/nullableString" },
        "a2a_contract_id": {
          "anyOf": [{ "type": "string", "pattern": "^a2a-\\d{3,}$" }, { "type": "null" }]
        }
      }
    },
    "a2aContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "remote_module_id",
        "target_agent_name",
        "target_agent_purpose",
        "contract_status",
        "agent_card",
        "supported_interfaces",
        "input_modes",
        "output_modes",
        "security_schemes",
        "security_requirements",
        "skills",
        "extensions",
        "message_contract",
        "task_lifecycle",
        "streaming",
        "operations",
        "http_paths",
        "artifact_contract",
        "adk_host_mapping",
        "timeout",
        "retry",
        "fallback",
        "cancellation",
        "unsupported_operation",
        "get_task_fallback",
        "push_notification_policy",
        "auth",
        "token_handling",
        "audit",
        "data_policy"
      ],
      "properties": {
        "contract_id": { "type": "string", "pattern": "^a2a-\\d{3,}$" },
        "remote_module_id": { "type": "string", "pattern": "^mod-[a-z0-9-]+$" },
        "target_agent_name": { "type": "string", "minLength": 1 },
        "target_agent_purpose": { "type": "string", "minLength": 1 },
        "contract_status": {
          "type": "string",
          "enum": ["draft", "needs_info", "approved"]
        },
        "agent_card": {
          "type": "object",
          "additionalProperties": false,
          "required": ["discovery_method", "agent_card_url", "version", "notes"],
          "properties": {
            "discovery_method": { "type": "string", "minLength": 1 },
            "agent_card_url": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "notes": { "type": "string", "minLength": 1 }
          }
        },
        "supported_interfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "protocol_binding", "protocol_version", "tenant_policy"],
            "properties": {
              "url": { "type": "string", "minLength": 1 },
              "protocol_binding": { "type": "string", "minLength": 1 },
              "protocol_version": { "type": "string", "minLength": 1 },
              "tenant_policy": { "type": "string", "minLength": 1 }
            }
          }
        },
        "input_modes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "output_modes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "security_schemes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "scheme"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "scheme": { "type": "string", "minLength": 1 }
            }
          }
        },
        "security_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scheme_name", "scopes"],
            "properties": {
              "scheme_name": { "type": "string", "minLength": 1 },
              "scopes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "skills": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "extensions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "message_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed_part_fields", "allowed_roles"],
          "properties": {
            "allowed_part_fields": {
              "type": "array",
              "items": { "$ref": "#/$defs/a2aPartField" }
            },
            "allowed_roles": {
              "type": "array",
              "items": { "$ref": "#/$defs/a2aRole" }
            }
          }
        },
        "task_lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "states",
            "allowed_transitions",
            "terminal_states",
            "input_required_followup",
            "auth_required_followup"
          ],
          "properties": {
            "states": { "type": "array", "items": { "$ref": "#/$defs/a2aTaskState" } },
            "allowed_transitions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to"],
                "properties": {
                  "from": { "$ref": "#/$defs/a2aTaskState" },
                  "to": { "$ref": "#/$defs/a2aTaskState" }
                }
              }
            },
            "terminal_states": { "type": "array", "items": { "$ref": "#/$defs/a2aTaskState" } },
            "input_required_followup": { "type": "string", "minLength": 1 },
            "auth_required_followup": { "type": "string", "minLength": 1 }
          }
        },
        "streaming": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "wrappers", "non_streaming_fallback"],
          "properties": {
            "supported": { "type": "boolean" },
            "wrappers": { "type": "array", "items": { "$ref": "#/$defs/a2aStreamWrapper" } },
            "non_streaming_fallback": { "type": "string", "minLength": 1 }
          }
        },
        "operations": { "type": "array", "items": { "$ref": "#/$defs/a2aOperationName" } },
        "http_paths": { "type": "array", "items": { "$ref": "#/$defs/a2aHttpPath" } },
        "artifact_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mutation_rules", "chunking_policy"],
          "properties": {
            "mutation_rules": { "type": "string", "minLength": 1 },
            "chunking_policy": { "type": "string", "minLength": 1 }
          }
        },
        "adk_host_mapping": { "type": "string", "minLength": 1 },
        "timeout": { "type": "string", "minLength": 1 },
        "retry": { "type": "string", "minLength": 1 },
        "fallback": { "type": "string", "minLength": 1 },
        "cancellation": { "type": "string", "minLength": 1 },
        "unsupported_operation": { "type": "string", "minLength": 1 },
        "get_task_fallback": { "type": "string", "minLength": 1 },
        "push_notification_policy": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "auth": { "type": "string", "minLength": 1 },
        "token_handling": { "type": "string", "minLength": 1 },
        "audit": { "type": "string", "minLength": 1 },
        "data_policy": { "type": "string", "minLength": 1 }
      }
    },
    "a2aOperationName": {
      "type": "string",
      "enum": [
        "SendMessage",
        "SendStreamingMessage",
        "GetTask",
        "SubscribeToTask",
        "CancelTask",
        "ListTasks"
      ]
    },
    "a2aHttpPath": {
      "type": "string",
      "enum": [
        "/message:send",
        "/message:stream",
        "/tasks/{id}",
        "/tasks/{id}:subscribe",
        "/tasks/{id}:cancel"
      ]
    },
    "a2aTaskState": {
      "type": "string",
      "enum": [
        "TASK_STATE_SUBMITTED",
        "TASK_STATE_WORKING",
        "TASK_STATE_INPUT_REQUIRED",
        "TASK_STATE_AUTH_REQUIRED",
        "TASK_STATE_COMPLETED",
        "TASK_STATE_FAILED",
        "TASK_STATE_CANCELED",
        "TASK_STATE_REJECTED"
      ]
    },
    "a2aPartField": {
      "type": "string",
      "enum": ["text", "raw", "url", "data"]
    },
    "a2aRole": {
      "type": "string",
      "enum": ["ROLE_USER", "ROLE_AGENT"]
    },
    "a2aStreamWrapper": {
      "type": "string",
      "enum": ["task", "message", "taskStatusUpdate", "taskArtifactUpdate"]
    },
    "processFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "nodes", "edges"],
      "properties": {
        "requirement_id": { "type": "string", "pattern": "^req-[a-z0-9-]+$" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/flowNode" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/flowEdge" }
        }
      }
    },
    "flowNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "subtype"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["input", "output", "agent", "workflow", "adapter", "remote_a2a"]
        },
        "subtype": { "$ref": "#/$defs/nullableString" }
      }
    },
    "flowEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "data",
        "edge_type",
        "data_channel",
        "state_key",
        "artifact_key",
        "schema_ref",
        "route_condition"
      ],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "data": { "type": "string" },
        "edge_type": { "type": "string", "enum": ["local", "remote_a2a"] },
        "data_channel": { "$ref": "#/$defs/flowDataChannel" },
        "state_key": { "$ref": "#/$defs/nullableString" },
        "artifact_key": { "$ref": "#/$defs/nullableString" },
        "schema_ref": { "$ref": "#/$defs/nullableString" },
        "route_condition": { "$ref": "#/$defs/nullableString" }
      }
    },
    "flowDataChannel": {
      "type": "string",
      "enum": [
        "event_output",
        "event_message",
        "session_state",
        "temp_state",
        "user_state",
        "app_state",
        "artifact",
        "route",
        "control",
        "unknown"
      ]
    }
  }
}
