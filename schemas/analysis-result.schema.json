{
  "type": "object",
  "additionalProperties": false,
  "required": ["normalizedRequirement", "evidence", "moduleCandidates", "processFlow"],
  "properties": {
    "normalizedRequirement": {
      "$ref": "#/$defs/normalizedRequirement"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "moduleCandidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/moduleCandidate"
      }
    },
    "processFlow": {
      "$ref": "#/$defs/processFlow"
    }
  },
  "$defs": {
    "nullableString": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "nullableBoolean": {
      "anyOf": [{ "type": "boolean" }, { "type": "null" }]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "required": { "type": "boolean" }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "access"],
      "properties": {
        "name": { "type": "string" },
        "access": {
          "type": "string",
          "enum": ["unknown", "read", "write", "read_write", "not_required"]
        }
      }
    },
    "adkHints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_memory",
        "callbacks",
        "artifacts_events",
        "mcp_a2a",
        "streaming_grounding"
      ],
      "properties": {
        "state_memory": { "$ref": "#/$defs/nullableString" },
        "callbacks": { "$ref": "#/$defs/nullableString" },
        "artifacts_events": { "$ref": "#/$defs/nullableString" },
        "mcp_a2a": { "$ref": "#/$defs/nullableString" },
        "streaming_grounding": { "$ref": "#/$defs/nullableString" }
      }
    },
    "riskSignal": {
      "type": "string",
      "enum": [
        "personal_data",
        "financial_data",
        "credit_decision_support",
        "customer_impact",
        "external_message",
        "transaction_write",
        "human_approval_required",
        "audit_required"
      ]
    },
    "normalizedRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "raw_text",
        "domain",
        "requester",
        "business_goal",
        "current_process",
        "inputs",
        "outputs",
        "systems",
        "risk_signals",
        "missing_information",
        "contradictions",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^req-[a-z0-9-]+$" },
        "title": { "type": "string" },
        "raw_text": { "type": "string" },
        "domain": { "type": "string" },
        "requester": {
          "type": "object",
          "additionalProperties": false,
          "required": ["team", "role"],
          "properties": {
            "team": { "type": "string" },
            "role": { "type": "string" }
          }
        },
        "business_goal": { "type": "string" },
        "current_process": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "systems": {
          "type": "array",
          "items": { "$ref": "#/$defs/system" }
        },
        "risk_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/riskSignal" }
        },
        "missing_information": {
          "type": "array",
          "items": { "type": "string" }
        },
        "contradictions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": ["draft", "reviewed", "approved", "rejected"]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_goal",
        "business_domain_hint",
        "user_role",
        "input_data",
        "output_data",
        "systems_mentioned",
        "decisions_implied",
        "risk_signals",
        "missing_information",
        "contradictions",
        "assumptions"
      ],
      "properties": {
        "requested_goal": { "type": "string" },
        "business_domain_hint": { "type": "string" },
        "user_role": { "type": "string" },
        "input_data": {
          "type": "array",
          "items": { "type": "string" }
        },
        "output_data": {
          "type": "array",
          "items": { "type": "string" }
        },
        "systems_mentioned": {
          "type": "array",
          "items": { "type": "string" }
        },
        "decisions_implied": {
          "type": "array",
          "items": { "type": "string" }
        },
        "risk_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/riskSignal" }
        },
        "missing_information": {
          "type": "array",
          "items": { "type": "string" }
        },
        "contradictions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "moduleCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_requirement_id",
        "name",
        "module_category",
        "agent_kind",
        "workflow_kind",
        "adapter_kind",
        "remote_contract_kind",
        "legacy_recommended_type",
        "confidence",
        "rationale",
        "adk_hints",
        "inputs",
        "outputs",
        "reuse_candidate",
        "risk_level",
        "risk_signals",
        "status",
        "missing_information",
        "side_effect",
        "auth_required",
        "audit_required",
        "citation_required",
        "grounding_required",
        "source_acl_required",
        "versioned",
        "effective_date_required",
        "owner_domain",
        "owner",
        "agent_card",
        "auth",
        "task_lifecycle",
        "timeout",
        "retry",
        "fallback",
        "audit",
        "data_policy"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^mod-[a-z0-9-]+$" },
        "source_requirement_id": { "type": "string", "pattern": "^req-[a-z0-9-]+$" },
        "name": { "type": "string" },
        "module_category": {
          "type": "string",
          "enum": ["agent", "workflow", "adapter", "remote_a2a"]
        },
        "agent_kind": {
          "anyOf": [{ "type": "string", "enum": ["specialist", "shared"] }, { "type": "null" }]
        },
        "workflow_kind": {
          "anyOf": [
            { "type": "string", "enum": ["sequential", "parallel", "loop", "human_review", "orchestration", "unknown"] },
            { "type": "null" }
          ]
        },
        "adapter_kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "legacy_api",
                "retrieval",
                "rule_registry",
                "data_query",
                "template",
                "computation",
                "external_service",
                "unknown"
              ]
            },
            { "type": "null" }
          ]
        },
        "remote_contract_kind": {
          "anyOf": [{ "type": "string", "enum": ["a2a", "unknown"] }, { "type": "null" }]
        },
        "legacy_recommended_type": { "$ref": "#/$defs/nullableString" },
        "confidence": { "type": "number" },
        "rationale": { "type": "string" },
        "adk_hints": {
          "anyOf": [{ "$ref": "#/$defs/adkHints" }, { "type": "null" }]
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "reuse_candidate": { "type": "boolean" },
        "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
        "risk_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/riskSignal" }
        },
        "status": {
          "type": "string",
          "enum": ["needs_info", "deferred", "rejected"]
        },
        "missing_information": {
          "type": "array",
          "items": { "type": "string" }
        },
        "side_effect": {
          "anyOf": [
            { "type": "string", "enum": ["none", "read", "write", "read_write", "unknown"] },
            { "type": "null" }
          ]
        },
        "auth_required": { "$ref": "#/$defs/nullableBoolean" },
        "audit_required": { "$ref": "#/$defs/nullableBoolean" },
        "citation_required": { "$ref": "#/$defs/nullableBoolean" },
        "grounding_required": { "$ref": "#/$defs/nullableBoolean" },
        "source_acl_required": { "$ref": "#/$defs/nullableBoolean" },
        "versioned": { "$ref": "#/$defs/nullableBoolean" },
        "effective_date_required": { "$ref": "#/$defs/nullableBoolean" },
        "owner_domain": { "$ref": "#/$defs/nullableString" },
        "owner": { "$ref": "#/$defs/nullableString" },
        "agent_card": { "$ref": "#/$defs/nullableString" },
        "auth": { "$ref": "#/$defs/nullableString" },
        "task_lifecycle": { "$ref": "#/$defs/nullableString" },
        "timeout": { "$ref": "#/$defs/nullableString" },
        "retry": { "$ref": "#/$defs/nullableString" },
        "fallback": { "$ref": "#/$defs/nullableString" },
        "audit": { "$ref": "#/$defs/nullableString" },
        "data_policy": { "$ref": "#/$defs/nullableString" }
      }
    },
    "processFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "nodes", "edges"],
      "properties": {
        "requirement_id": { "type": "string", "pattern": "^req-[a-z0-9-]+$" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/flowNode" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/flowEdge" }
        }
      }
    },
    "flowNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "subtype"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["input", "output", "agent", "workflow", "adapter", "remote_a2a"]
        },
        "subtype": { "$ref": "#/$defs/nullableString" }
      }
    },
    "flowEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "data", "edge_type"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "data": { "type": "string" },
        "edge_type": { "type": "string", "enum": ["local", "remote_a2a"] }
      }
    }
  }
}
