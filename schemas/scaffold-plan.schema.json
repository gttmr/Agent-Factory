{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/scaffold-plan.schema.json",
  "title": "Scaffold Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirement_id", "source", "raw_requirement_to_code", "modules", "runtime_contracts", "excluded_modules", "manifest", "validation"],
  "properties": {
    "requirement_id": {
      "type": "string",
      "pattern": "^req-[a-z0-9-]+$"
    },
    "package_name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "Optional explicit Python package directory name for generated ADK skeletons."
    },
    "source": {
      "type": "string",
      "const": "approved_workbench_artifact"
    },
    "raw_requirement_to_code": {
      "type": "boolean",
      "const": false
    },
    "output_mode": {
      "type": "string",
      "enum": ["smoke", "runnable"],
      "description": "Defaults to smoke when absent. runnable allows reviewed LlmAgent/MCP wiring; raw_requirement_to_code stays false in both modes."
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "runtime_contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/runtime_contract"
      }
    },
    "graph": {
      "$ref": "#/$defs/graph"
    },
    "excluded_modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/excluded_module"
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_bound_modules", "new_code_required"],
      "properties": {
        "catalog_bound_modules": {
          "type": "array",
          "items": { "$ref": "#/$defs/catalog_bound_module" }
        },
        "new_code_required": {
          "type": "array",
          "items": { "$ref": "#/$defs/new_code_required" }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_generate_source", "blockers", "warnings"],
      "properties": {
        "can_generate_source": { "type": "boolean" },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "description": "Correlate output_mode with module runnable flags. Absent output_mode is treated as smoke.",
      "if": {
        "required": ["output_mode"],
        "properties": { "output_mode": { "const": "runnable" } }
      },
      "then": {
        "properties": {
          "modules": {
            "items": {
              "properties": {
                "no_runnable_business_logic": { "const": false },
                "scaffold_output": { "const": "runnable" }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "modules": {
            "items": {
              "properties": {
                "no_runnable_business_logic": { "const": true },
                "scaffold_output": {
                  "enum": [
                    "contract_or_stub_only",
                    "agent_shell_only",
                    "orchestration_shell_only",
                    "contract_placeholder_only"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "module_category",
        "agent_kind",
        "workflow_kind",
        "adapter_kind",
        "remote_contract_kind",
        "scaffold_output",
        "no_runnable_business_logic",
        "inputs",
        "outputs",
        "required_review_fields",
        "developer_todos",
        "risk_signals",
        "runtime_mock"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^mod-[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "module_category": {
          "type": "string",
          "enum": ["agent", "workflow", "adapter", "remote_a2a"]
        },
        "agent_kind": {
          "anyOf": [{ "type": "string", "enum": ["specialist", "shared"] }, { "type": "null" }]
        },
        "workflow_kind": {
          "anyOf": [
            { "type": "string", "enum": ["orchestration", "graph", "dynamic", "unknown"] },
            { "type": "null" }
          ]
        },
        "adapter_kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "legacy_api",
                "retrieval",
                "rule_registry",
                "data_query",
                "template",
                "computation",
                "external_service",
                "unknown"
              ]
            },
            { "type": "null" }
          ]
        },
        "remote_contract_kind": {
          "anyOf": [{ "type": "string", "enum": ["a2a", "unknown"] }, { "type": "null" }]
        },
        "scaffold_output": {
          "type": "string",
          "enum": ["contract_or_stub_only", "agent_shell_only", "orchestration_shell_only", "contract_placeholder_only", "runnable"]
        },
        "no_runnable_business_logic": {
          "type": "boolean",
          "description": "true in smoke mode; the validator allows false only when the plan's output_mode is runnable."
        },
        "catalog_binding": {
          "anyOf": [{ "$ref": "#/$defs/catalog_binding" }, { "type": "null" }]
        },
        "developer_todos": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "required_review_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "risk_signals": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "personal_data",
              "financial_data",
              "credit_decision_support",
              "customer_impact",
              "external_message",
              "transaction_write",
              "human_approval_required",
              "audit_required"
            ]
          }
        },
        "runtime_mock": {
          "anyOf": [{ "type": "object" }, { "type": "null" }]
        },
        "instruction": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "model": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "agent_execution_mode": {
          "anyOf": [{ "type": "string", "enum": ["single_turn", "chat"] }, { "type": "null" }]
        },
        "access_protocol": {
          "anyOf": [
            { "type": "string", "enum": ["local", "http_rest", "mcp", "grpc", "message_queue", "unknown"] },
            { "type": "null" }
          ]
        },
        "mcp_server": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "mcp_tool_name": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "mcp_schema_ref": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "mcp_auth_mode": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "runtime_binding": {
          "anyOf": [
            { "type": "string", "enum": ["unresolved", "direct_api", "mcp", "mcp_tool", "local_function", "remote_a2a", "workflow_call", "ui_input"] },
            { "type": "null" }
          ]
        },
        "invoke_binding": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "unresolved",
                "local_python",
                "direct_api",
                "mcp_tool",
                "mcp_toolset",
                "local_function",
                "internal_workflow",
                "ui_input",
                "remote_a2a",
                "callback_wait",
                "unknown"
              ]
            },
            { "type": "null" }
          ]
        },
        "decision_owner": {
          "anyOf": [
            { "type": "string", "enum": ["workflow_code", "llm", "human", "remote_agent", "system", "unknown"] },
            { "type": "null" }
          ]
        },
        "call_control": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "none",
                "fixed_by_workflow",
                "selected_by_llm",
                "selected_by_human",
                "event_callback",
                "resume",
                "unknown"
              ]
            },
            { "type": "null" }
          ]
        },
        "side_effect": {
          "anyOf": [
            { "type": "string", "enum": ["none", "read", "write", "external_message", "transaction", "unknown"] },
            { "type": "null" }
          ]
        },
        "policy": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "none",
                "auth_required",
                "approval_required",
                "audit_required",
                "idempotency_required",
                "timeout_retry_required",
                "data_policy_required",
                "manual_fallback_required",
                "callback_resume_required",
                "compensation_required",
                "unknown"
              ]
            },
            { "type": "null" }
          ]
        },
        "node_kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "input",
                "output",
                "agent",
                "function",
                "tool",
                "adapter",
                "adapter_call",
                "human_input",
                "callback_wait",
                "workflow",
                "workflow_call",
                "remote_a2a",
                "remote_agent_call",
                "join",
                "router",
                "loop_control"
              ]
            },
            { "type": "null" }
          ]
        },
        "workflow_ref": {
          "anyOf": [{ "$ref": "#/$defs/workflow_ref" }, { "type": "null" }]
        },
        "input_mapping": {
          "anyOf": [{ "type": "object", "additionalProperties": { "type": "string" } }, { "type": "null" }]
        },
        "output_mapping": {
          "anyOf": [{ "type": "object", "additionalProperties": { "type": "string" } }, { "type": "null" }]
        },
        "mock_binding": {
          "anyOf": [{ "$ref": "#/$defs/mock_binding" }, { "type": "null" }]
        },
        "adk_skeleton_contract": {
          "$ref": "#/$defs/adk_skeleton_contract"
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/graph_node" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/graph_edge" }
        }
      }
    },
    "human_input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "payload_schema_ref", "response_schema_ref", "response_mapping"],
      "properties": {
        "message": { "type": "string", "minLength": 1 },
        "payload_schema_ref": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "response_schema_ref": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "response_mapping": {
          "anyOf": [
            { "type": "object", "additionalProperties": { "type": "string" } },
            { "type": "null" }
          ]
        },
        "choice_options": {
          "anyOf": [{ "type": "array", "items": { "type": "string", "minLength": 1 } }, { "type": "null" }]
        },
        "accepted_aliases": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            { "type": "null" }
          ]
        },
        "default_choice": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      }
    },
    "graph_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module_id",
        "node_kind",
        "invoke_binding",
        "decision_owner",
        "call_control",
        "side_effect",
        "policy"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "module_id": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "node_kind": {
          "type": "string",
          "enum": [
            "input",
            "output",
            "agent",
            "function",
            "tool",
            "adapter",
            "adapter_call",
            "human_input",
            "callback_wait",
            "workflow",
            "workflow_call",
            "remote_a2a",
            "remote_agent_call",
            "join",
            "router",
            "loop_control"
          ]
        },
        "invoke_binding": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "unresolved",
                "local_python",
                "direct_api",
                "mcp_tool",
                "mcp_toolset",
                "local_function",
                "internal_workflow",
                "ui_input",
                "remote_a2a",
                "callback_wait",
                "unknown"
              ]
            },
            { "type": "null" }
          ]
        },
        "decision_owner": {
          "anyOf": [
            { "type": "string", "enum": ["workflow_code", "llm", "human", "remote_agent", "system", "unknown"] },
            { "type": "null" }
          ]
        },
        "call_control": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "none",
                "fixed_by_workflow",
                "selected_by_llm",
                "selected_by_human",
                "event_callback",
                "resume",
                "unknown"
              ]
            },
            { "type": "null" }
          ]
        },
        "side_effect": {
          "anyOf": [
            { "type": "string", "enum": ["none", "read", "write", "external_message", "transaction", "unknown"] },
            { "type": "null" }
          ]
        },
        "policy": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "none",
                "auth_required",
                "approval_required",
                "audit_required",
                "idempotency_required",
                "timeout_retry_required",
                "data_policy_required",
                "manual_fallback_required",
                "callback_resume_required",
                "compensation_required",
                "unknown"
              ]
            },
            { "type": "null" }
          ]
        },
        "human_input_contract": {
          "anyOf": [{ "$ref": "#/$defs/human_input_contract" }, { "type": "null" }]
        }
      }
    },
    "graph_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "edge_kind",
        "schema_ref",
        "route_condition",
        "state_key",
        "artifact_key",
        "flow_kind",
        "call_control"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "edge_kind": {
          "type": "string",
          "enum": [
            "event_output",
            "event_message",
            "session_state",
            "temp_state",
            "user_state",
            "app_state",
            "artifact",
            "route",
            "control",
            "remote_a2a"
          ]
        },
        "schema_ref": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "route_condition": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "route_aliases": {
          "anyOf": [
            { "type": "array", "items": { "type": "string", "minLength": 1 } },
            { "type": "null" }
          ]
        },
        "is_default_route": {
          "anyOf": [{ "type": "boolean" }, { "type": "null" }]
        },
        "state_key": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "artifact_key": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "flow_kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "sequence",
                "route",
                "fan_out",
                "fan_in",
                "loop_back",
                "loop_exit",
                "fallback",
                "error",
                "resume",
                "callback",
                "unknown"
              ]
            },
            { "type": "null" }
          ]
        },
        "call_control": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "none",
                "fixed_by_workflow",
                "selected_by_llm",
                "selected_by_human",
                "event_callback",
                "resume",
                "unknown"
              ]
            },
            { "type": "null" }
          ]
        }
      }
    },
    "workflow_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source", "display_name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "source": { "type": "string", "enum": ["catalog", "artifact", "placeholder"] },
        "display_name": { "type": "string", "minLength": 1 }
      }
    },
    "mock_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "package_path", "mock_server_id", "tool_name", "input_schema", "output_schema", "sample_response_ref", "status"],
      "properties": {
        "provider": { "type": "string", "const": "mock_lab" },
        "package_path": { "type": "string", "const": "packages/mock-lab" },
        "mock_server_id": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "tool_name": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "input_schema": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "output_schema": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "sample_response_ref": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "status": { "type": "string", "enum": ["linked", "missing", "invalid"] }
      }
    },
    "adk_skeleton_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scaffold_level", "implementation_template", "manual_completion_required", "developer_todos"],
      "properties": {
        "scaffold_level": { "type": "string", "enum": ["none", "handoff", "mock_testable_skeleton", "manual_required"] },
        "target_runtime": { "type": "string", "enum": ["adk_python_2_x"] },
        "entrypoint": { "type": "string", "enum": ["root_agent"] },
        "generation_mode": { "type": "string", "enum": ["deterministic_template", "llm_assisted_patch", "manual"] },
        "implementation_template": { "type": "string", "minLength": 1 },
        "manual_completion_required": { "type": "boolean" },
        "developer_todos": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "runtime_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_kind",
        "module_id",
        "title",
        "contract_status",
        "required_review_fields",
        "runtime_support",
        "operation",
        "identifiers",
        "policies",
        "graph_ir_annotations",
        "developer_todos"
      ],
      "properties": {
        "contract_id": { "type": "string", "pattern": "^rtc-[a-z0-9-]+$" },
        "contract_kind": {
          "type": "string",
          "enum": [
            "mcp_legacy_adapter",
            "eai_legacy_adapter",
            "context_manager",
            "callback_broker",
            "adk_callback",
            "async_resume"
          ]
        },
        "module_id": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "title": { "type": "string", "minLength": 1 },
        "contract_status": { "type": "string", "enum": ["draft", "needs_info", "approved", "rejected"] },
        "required_review_fields": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "runtime_support": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "operation": { "type": "object", "additionalProperties": true },
        "identifiers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "policies": { "type": "object", "additionalProperties": { "type": "string" } },
        "graph_ir_annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "developer_todos": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "catalog_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "name", "component_source"],
      "properties": {
        "catalog_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "component_source": { "type": "string", "enum": ["mcp", "remote_a2a", "stub"] }
      }
    },
    "excluded_module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "reason"],
      "properties": {
        "id": { "type": "string", "pattern": "^mod-[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["needs_info", "approved", "deferred", "rejected"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "catalog_bound_module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "module_name", "catalog_id", "catalog_name", "component_source"],
      "properties": {
        "module_id": { "type": "string", "pattern": "^mod-[a-z0-9-]+$" },
        "module_name": { "type": "string", "minLength": 1 },
        "catalog_id": { "type": "string", "minLength": 1 },
        "catalog_name": { "type": "string", "minLength": 1 },
        "component_source": { "type": "string", "enum": ["mcp", "remote_a2a", "stub"] }
      }
    },
    "new_code_required": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "module_name", "reason", "developer_todos"],
      "properties": {
        "module_id": { "type": "string", "pattern": "^mod-[a-z0-9-]+$" },
        "module_name": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "developer_todos": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
