{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/scaffold-plan.schema.json",
  "title": "Scaffold Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirement_id", "source", "raw_requirement_to_code", "modules", "excluded_modules", "manifest", "validation"],
  "properties": {
    "requirement_id": {
      "type": "string",
      "pattern": "^req-[a-z0-9-]+$"
    },
    "source": {
      "type": "string",
      "const": "approved_workbench_artifact"
    },
    "raw_requirement_to_code": {
      "type": "boolean",
      "const": false
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "excluded_modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/excluded_module"
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_bound_modules", "new_code_required"],
      "properties": {
        "catalog_bound_modules": {
          "type": "array",
          "items": { "$ref": "#/$defs/catalog_bound_module" }
        },
        "new_code_required": {
          "type": "array",
          "items": { "$ref": "#/$defs/new_code_required" }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_generate_source", "blockers", "warnings"],
      "properties": {
        "can_generate_source": { "type": "boolean" },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "module_category",
        "agent_kind",
        "workflow_kind",
        "adapter_kind",
        "remote_contract_kind",
        "scaffold_output",
        "no_runnable_business_logic",
        "inputs",
        "outputs",
        "required_review_fields",
        "developer_todos",
        "risk_signals"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^mod-[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "module_category": {
          "type": "string",
          "enum": ["agent", "workflow", "adapter", "remote_a2a"]
        },
        "agent_kind": {
          "anyOf": [{ "type": "string", "enum": ["specialist", "shared"] }, { "type": "null" }]
        },
        "workflow_kind": {
          "anyOf": [
            { "type": "string", "enum": ["orchestration", "graph", "dynamic", "unknown"] },
            { "type": "null" }
          ]
        },
        "adapter_kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "legacy_api",
                "retrieval",
                "rule_registry",
                "data_query",
                "template",
                "computation",
                "external_service",
                "unknown"
              ]
            },
            { "type": "null" }
          ]
        },
        "remote_contract_kind": {
          "anyOf": [{ "type": "string", "enum": ["a2a", "unknown"] }, { "type": "null" }]
        },
        "scaffold_output": {
          "type": "string",
          "enum": ["contract_or_stub_only", "agent_shell_only", "orchestration_shell_only", "contract_placeholder_only"]
        },
        "no_runnable_business_logic": {
          "type": "boolean",
          "const": true
        },
        "catalog_binding": {
          "anyOf": [{ "$ref": "#/$defs/catalog_binding" }, { "type": "null" }]
        },
        "developer_todos": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "required_review_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "risk_signals": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "personal_data",
              "financial_data",
              "credit_decision_support",
              "customer_impact",
              "external_message",
              "transaction_write",
              "human_approval_required",
              "audit_required"
            ]
          }
        }
      }
    },
    "catalog_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "name", "component_source"],
      "properties": {
        "catalog_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "component_source": { "type": "string", "enum": ["mcp", "remote_a2a", "stub"] }
      }
    },
    "excluded_module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "reason"],
      "properties": {
        "id": { "type": "string", "pattern": "^mod-[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["needs_info", "approved", "deferred", "rejected"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "catalog_bound_module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "module_name", "catalog_id", "catalog_name", "component_source"],
      "properties": {
        "module_id": { "type": "string", "pattern": "^mod-[a-z0-9-]+$" },
        "module_name": { "type": "string", "minLength": 1 },
        "catalog_id": { "type": "string", "minLength": 1 },
        "catalog_name": { "type": "string", "minLength": 1 },
        "component_source": { "type": "string", "enum": ["mcp", "remote_a2a", "stub"] }
      }
    },
    "new_code_required": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "module_name", "reason", "developer_todos"],
      "properties": {
        "module_id": { "type": "string", "pattern": "^mod-[a-z0-9-]+$" },
        "module_name": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "developer_todos": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
