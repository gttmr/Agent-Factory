{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/process-flow.schema.json",
  "title": "Graph IR (ADK 2.0)",
  "description": "Graph IR replaces the legacy stage-based ProcessFlow. Stored on AnalysisResult.processFlow for migration compatibility; the field name is intentionally unchanged while the inner shape is rewritten.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirement_id",
    "graph_id",
    "root_workflow_module_id",
    "nodes",
    "edges",
    "containers",
    "lanes",
    "validation"
  ],
  "properties": {
    "requirement_id": {
      "type": "string",
      "pattern": "^req-[a-z0-9-]+$"
    },
    "graph_id": {
      "type": "string",
      "pattern": "^graph-[0-9]+$"
    },
    "root_workflow_module_id": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "containers": {
      "type": "array",
      "items": { "$ref": "#/$defs/container" }
    },
    "lanes": {
      "type": "array",
      "items": { "$ref": "#/$defs/lane" }
    },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "nullableString": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "agentExecutionMode": {
      "anyOf": [{ "type": "string", "enum": ["single_turn", "chat"] }, { "type": "null" }]
    },
    "nodeKind": {
      "type": "string",
      "enum": [
        "input",
        "output",
        "agent",
        "function",
        "tool",
        "adapter",
        "adapter_call",
        "human_input",
        "callback_wait",
        "workflow",
        "workflow_call",
        "remote_a2a",
        "remote_agent_call",
        "join",
        "router",
        "loop_control"
      ]
    },
    "containerKind": {
      "type": "string",
      "enum": [
        "graph_workflow",
        "dynamic_workflow",
        "parallel_region",
        "loop_region",
        "human_review_region",
        "remote_boundary"
      ]
    },
    "edgeKind": {
      "type": "string",
      "enum": [
        "event_output",
        "event_message",
        "session_state",
        "temp_state",
        "user_state",
        "app_state",
        "artifact",
        "route",
        "control",
        "remote_a2a"
      ]
    },
    "laneId": {
      "type": "string",
      "enum": ["input", "local_graph", "adapter", "human_input", "output", "remote_boundary"]
    },
    "layoutPolicy": {
      "type": "string",
      "enum": ["dag_with_routes", "fan_out_fan_in", "loop", "linear", "free"]
    },
    "executionSemantics": {
      "type": "string",
      "enum": [
        "normal_transition",
        "fan_out",
        "fan_in",
        "loop_back",
        "loop_exit",
        "conditional",
        "boundary_crossing"
      ]
    },
    "ownerScope": {
      "type": "string",
      "enum": ["local", "remote", "external"]
    },
    "adkNodeRole": {
      "anyOf": [
        { "type": "string", "enum": ["workflow_node", "container_root", "boundary", "synthetic"] },
        { "type": "null" }
      ]
    },
    "reviewStatus": {
      "type": "string",
      "enum": ["needs_info", "approved", "deferred", "rejected", "n/a"]
    },
    "runtimeBinding": {
      "type": "string",
      "enum": ["unresolved", "direct_api", "mcp", "mcp_tool", "local_function", "remote_a2a", "workflow_call", "ui_input"]
    },
    "invokeBinding": {
      "type": "string",
      "enum": [
        "unresolved",
        "local_python",
        "direct_api",
        "mcp_tool",
        "mcp_toolset",
        "local_function",
        "internal_workflow",
        "ui_input",
        "remote_a2a",
        "callback_wait",
        "unknown"
      ]
    },
    "decisionOwner": {
      "type": "string",
      "enum": ["workflow_code", "llm", "human", "remote_agent", "system", "unknown"]
    },
    "callControl": {
      "type": "string",
      "enum": ["none", "fixed_by_workflow", "selected_by_llm", "selected_by_human", "event_callback", "resume", "unknown"]
    },
    "flowKind": {
      "type": "string",
      "enum": ["sequence", "route", "fan_out", "fan_in", "loop_back", "loop_exit", "fallback", "error", "resume", "callback", "unknown"]
    },
    "sideEffect": {
      "type": "string",
      "enum": ["none", "read", "write", "external_message", "transaction", "unknown"]
    },
    "policy": {
      "type": "string",
      "enum": [
        "none",
        "auth_required",
        "approval_required",
        "audit_required",
        "idempotency_required",
        "timeout_retry_required",
        "data_policy_required",
        "manual_fallback_required",
        "callback_resume_required",
        "compensation_required",
        "unknown"
      ]
    },
    "workflowRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source", "display_name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/nullableString" },
        "source": { "type": "string", "enum": ["catalog", "artifact", "placeholder"] },
        "display_name": { "type": "string", "minLength": 1 }
      }
    },
    "stringMapping": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "mockBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "package_path", "mock_server_id", "tool_name", "input_schema", "output_schema", "sample_response_ref", "status"],
      "properties": {
        "provider": { "type": "string", "const": "mock_lab" },
        "package_path": { "type": "string", "const": "packages/mock-lab" },
        "mock_server_id": { "$ref": "#/$defs/nullableString" },
        "tool_name": { "$ref": "#/$defs/nullableString" },
        "input_schema": { "$ref": "#/$defs/nullableString" },
        "output_schema": { "$ref": "#/$defs/nullableString" },
        "sample_response_ref": { "$ref": "#/$defs/nullableString" },
        "status": { "type": "string", "enum": ["linked", "missing", "invalid"] }
      }
    },
    "adkSkeletonContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scaffold_level", "implementation_template", "manual_completion_required", "developer_todos"],
      "properties": {
        "scaffold_level": { "type": "string", "enum": ["none", "handoff", "mock_testable_skeleton", "manual_required"] },
        "target_runtime": { "type": "string", "enum": ["adk_python_2_x"] },
        "entrypoint": { "type": "string", "enum": ["root_agent"] },
        "generation_mode": { "type": "string", "enum": ["deterministic_template", "llm_assisted_patch", "manual"] },
        "implementation_template": { "type": "string", "minLength": 1 },
        "manual_completion_required": { "type": "boolean" },
        "developer_todos": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "schema_ref"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "schema_ref": { "$ref": "#/$defs/nullableString" }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module_id",
        "label",
        "node_kind",
        "execution_kind",
        "adk_node_role",
        "owner_scope",
        "container_id",
        "lane_id",
        "input_ports",
        "output_ports",
        "schema_refs",
        "review_status"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "module_id": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "label": { "type": "string", "minLength": 1 },
        "node_kind": { "$ref": "#/$defs/nodeKind" },
        "execution_kind": { "$ref": "#/$defs/nullableString" },
        "agent_execution_mode": { "$ref": "#/$defs/agentExecutionMode" },
        "adk_node_role": { "$ref": "#/$defs/adkNodeRole" },
        "owner_scope": { "$ref": "#/$defs/ownerScope" },
        "container_id": {
          "anyOf": [{ "type": "string", "minLength": 1, "pattern": "^container-[a-z0-9-]+$" }, { "type": "null" }]
        },
        "lane_id": { "$ref": "#/$defs/laneId" },
        "input_ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "output_ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "schema_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "review_status": { "$ref": "#/$defs/reviewStatus" },
        "position": {
          "anyOf": [{ "$ref": "#/$defs/position" }, { "type": "null" }]
        },
        "workflow_ref": { "anyOf": [{ "$ref": "#/$defs/workflowRef" }, { "type": "null" }] },
        "input_schema": { "$ref": "#/$defs/nullableString" },
        "output_schema": { "$ref": "#/$defs/nullableString" },
        "input_mapping": { "anyOf": [{ "$ref": "#/$defs/stringMapping" }, { "type": "null" }] },
        "output_mapping": { "anyOf": [{ "$ref": "#/$defs/stringMapping" }, { "type": "null" }] },
        "runtime_binding": { "anyOf": [{ "$ref": "#/$defs/runtimeBinding" }, { "type": "null" }] },
        "invoke_binding": { "anyOf": [{ "$ref": "#/$defs/invokeBinding" }, { "type": "null" }] },
        "decision_owner": { "anyOf": [{ "$ref": "#/$defs/decisionOwner" }, { "type": "null" }] },
        "call_control": { "anyOf": [{ "$ref": "#/$defs/callControl" }, { "type": "null" }] },
        "side_effect": { "anyOf": [{ "$ref": "#/$defs/sideEffect" }, { "type": "null" }] },
        "policy": { "anyOf": [{ "$ref": "#/$defs/policy" }, { "type": "null" }] },
        "mock_binding": { "anyOf": [{ "$ref": "#/$defs/mockBinding" }, { "type": "null" }] },
        "adk_skeleton_contract": { "anyOf": [{ "$ref": "#/$defs/adkSkeletonContract" }, { "type": "null" }] }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "from_port",
        "to_port",
        "edge_kind",
        "execution_semantics",
        "data_label",
        "schema_ref",
        "route_condition",
        "state_key",
        "artifact_key",
        "a2a_contract_id",
        "is_remote_boundary_crossing"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^edge-[0-9]+$" },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "from_port": { "$ref": "#/$defs/nullableString" },
        "to_port": { "$ref": "#/$defs/nullableString" },
        "edge_kind": { "$ref": "#/$defs/edgeKind" },
        "execution_semantics": { "$ref": "#/$defs/executionSemantics" },
        "data_label": { "type": "string" },
        "schema_ref": { "$ref": "#/$defs/nullableString" },
        "route_condition": { "$ref": "#/$defs/nullableString" },
        "state_key": { "$ref": "#/$defs/nullableString" },
        "artifact_key": { "$ref": "#/$defs/nullableString" },
        "a2a_contract_id": { "$ref": "#/$defs/nullableString" },
        "is_remote_boundary_crossing": { "type": "boolean" },
        "flow_kind": { "anyOf": [{ "$ref": "#/$defs/flowKind" }, { "type": "null" }] },
        "call_control": { "anyOf": [{ "$ref": "#/$defs/callControl" }, { "type": "null" }] }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module_id",
        "label",
        "container_kind",
        "adk_mapping",
        "contains_node_ids",
        "entry_node_ids",
        "exit_node_ids",
        "layout_policy",
        "parent_container_id"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^container-[a-z0-9-]+$" },
        "module_id": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "label": { "type": "string", "minLength": 1 },
        "container_kind": { "$ref": "#/$defs/containerKind" },
        "adk_mapping": { "$ref": "#/$defs/nullableString" },
        "contains_node_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "entry_node_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "exit_node_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "layout_policy": { "$ref": "#/$defs/layoutPolicy" },
        "parent_container_id": {
          "anyOf": [{ "type": "string", "minLength": 1, "pattern": "^container-[a-z0-9-]+$" }, { "type": "null" }]
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/laneId" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "validationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "target_kind", "target_id"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "target_kind": {
          "type": "string",
          "enum": ["node", "edge", "container", "graph"]
        },
        "target_id": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "errors", "warnings"],
      "properties": {
        "ok": { "type": "boolean" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/validationIssue" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/validationIssue" } }
      }
    }
  }
}
