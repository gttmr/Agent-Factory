{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/process-flow.schema.json",
  "title": "Process Flow",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirement_id", "nodes", "edges"],
  "properties": {
    "requirement_id": {
      "type": "string",
      "pattern": "^req-[a-z0-9-]+$"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "nodeType": {
      "type": "string",
      "enum": ["input", "output", "agent", "workflow", "adapter", "remote_a2a"]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/nodeType"
        },
        "subtype": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "data"],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "string",
          "minLength": 1
        },
        "edge_type": {
          "type": "string",
          "enum": ["local", "remote_a2a"],
          "default": "local"
        },
        "data_channel": {
          "$ref": "#/$defs/dataChannel"
        },
        "state_key": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "artifact_key": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "schema_ref": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "route_condition": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      }
    },
    "dataChannel": {
      "type": "string",
      "enum": [
        "event_output",
        "event_message",
        "session_state",
        "temp_state",
        "user_state",
        "app_state",
        "artifact",
        "route",
        "control",
        "unknown"
      ]
    }
  }
}
