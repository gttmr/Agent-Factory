{
  "type": "object",
  "additionalProperties": false,
  "required": ["normalizedRequirement", "evidence", "moduleCandidates", "a2aContracts", "runtimeContracts", "processFlow"],
  "properties": {
    "normalizedRequirement": { "$ref": "#/$defs/normalizedRequirementDraft" },
    "evidence": { "$ref": "#/$defs/evidenceDraft" },
    "moduleCandidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/moduleCandidateDraft" }
    },
    "a2aContracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/a2aContractDraft" }
    },
    "runtimeContracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/runtimeContractDraft" }
    },
    "processFlow": { "$ref": "#/$defs/processFlowDraft" }
  },
  "$defs": {
    "nullableString": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "agentExecutionMode": {
      "anyOf": [{ "type": "string", "enum": ["single_turn", "chat"] }, { "type": "null" }]
    },
    "nullableBoolean": {
      "anyOf": [{ "type": "boolean" }, { "type": "null" }]
    },
    "runtimeContractDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "contract_kind", "contract_status"],
      "properties": {
        "contract_id": { "type": "string" },
        "contract_kind": {
          "type": "string",
          "enum": [
            "mcp_legacy_adapter",
            "eai_legacy_adapter",
            "context_manager",
            "callback_broker",
            "adk_callback",
            "async_resume"
          ]
        },
        "contract_status": { "type": "string", "enum": ["draft", "needs_info", "approved", "rejected"] }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "schema"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "required": { "type": "boolean" },
        "schema": { "$ref": "#/$defs/jsonSchema" }
      }
    },
    "jsonSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "smokeSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_user_message",
        "synthetic_inputs",
        "expected_output_shape",
        "expected_event_markers",
        "mock_sources",
        "ready"
      ],
      "properties": {
        "sample_user_message": { "type": "string" },
        "synthetic_inputs": { "type": "object", "additionalProperties": false, "required": [], "properties": {} },
        "expected_output_shape": { "$ref": "#/$defs/jsonSchema" },
        "expected_event_markers": { "type": "array", "items": { "type": "string" } },
        "mock_sources": { "type": "array", "items": { "type": "string" } },
        "ready": { "type": "boolean" }
      }
    },
    "resolutionDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "access"],
      "properties": {
        "name": { "type": "string" },
        "access": {
          "type": "string",
          "enum": ["unknown", "read", "write", "read_write", "not_required"]
        }
      }
    },
    "riskSignal": {
      "type": "string",
      "enum": [
        "personal_data",
        "financial_data",
        "credit_decision_support",
        "customer_impact",
        "external_message",
        "transaction_write",
        "human_approval_required",
        "audit_required"
      ]
    },
    "adkHints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_memory", "callbacks", "artifacts_events", "mcp_a2a", "streaming_grounding"],
      "properties": {
        "state_memory": { "$ref": "#/$defs/nullableString" },
        "callbacks": { "$ref": "#/$defs/nullableString" },
        "artifacts_events": { "$ref": "#/$defs/nullableString" },
        "mcp_a2a": { "$ref": "#/$defs/nullableString" },
        "streaming_grounding": { "$ref": "#/$defs/nullableString" }
      }
    },
    "normalizedRequirementDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "raw_text",
        "domain",
        "requester",
        "business_goal",
        "current_process",
        "inputs",
        "outputs",
        "systems",
        "risk_signals",
        "missing_information",
        "contradictions",
        "status"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "raw_text": { "type": "string" },
        "domain": { "type": "string" },
        "requester": {
          "type": "object",
          "additionalProperties": false,
          "required": ["team", "role"],
          "properties": {
            "team": { "type": "string" },
            "role": { "type": "string" }
          }
        },
        "business_goal": { "type": "string" },
        "current_process": { "type": "array", "items": { "type": "string" } },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "systems": { "type": "array", "items": { "$ref": "#/$defs/system" } },
        "risk_signals": { "type": "array", "items": { "$ref": "#/$defs/riskSignal" } },
        "missing_information": { "type": "array", "items": { "type": "string" } },
        "contradictions": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["draft", "reviewed", "approved", "rejected"] }
      }
    },
    "evidenceDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_goal",
        "business_domain_hint",
        "user_role",
        "input_data",
        "output_data",
        "systems_mentioned",
        "decisions_implied",
        "risk_signals",
        "missing_information",
        "contradictions",
        "assumptions"
      ],
      "properties": {
        "requested_goal": { "type": "string" },
        "business_domain_hint": { "type": "string" },
        "user_role": { "type": "string" },
        "input_data": { "type": "array", "items": { "type": "string" } },
        "output_data": { "type": "array", "items": { "type": "string" } },
        "systems_mentioned": { "type": "array", "items": { "type": "string" } },
        "decisions_implied": { "type": "array", "items": { "type": "string" } },
        "risk_signals": { "type": "array", "items": { "$ref": "#/$defs/riskSignal" } },
        "missing_information": { "type": "array", "items": { "type": "string" } },
        "contradictions": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "moduleCandidateDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "catalog_entry_id",
        "source_requirement_id",
        "name",
        "module_category",
        "agent_kind",
        "workflow_kind",
        "adapter_kind",
        "remote_contract_kind",
        "confidence",
        "rationale",
        "adk_hints",
        "inputs",
        "outputs",
        "reuse_candidate",
        "risk_level",
        "risk_signals",
        "status",
        "missing_information",
        "missing_information_resolution",
        "resolved_missing_information",
        "resolution_draft",
        "resolution_applied_at",
        "schema_review_state",
        "smoke_spec",
        "side_effect",
        "owner_domain",
        "developer_todos",
        "a2a_contract_id"
      ],
      "properties": {
        "id": { "type": "string" },
        "catalog_entry_id": { "$ref": "#/$defs/nullableString" },
        "source_requirement_id": { "type": "string" },
        "name": { "type": "string" },
        "module_category": { "type": "string", "enum": ["agent", "workflow", "adapter", "remote_a2a"] },
        "agent_kind": {
          "anyOf": [{ "type": "string", "enum": ["specialist", "shared"] }, { "type": "null" }]
        },
        "workflow_kind": {
          "anyOf": [{ "type": "string", "enum": ["orchestration", "graph", "dynamic", "unknown"] }, { "type": "null" }]
        },
        "adapter_kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "legacy_api",
                "retrieval",
                "rule_registry",
                "data_query",
                "template",
                "computation",
                "external_service",
                "unknown"
              ]
            },
            { "type": "null" }
          ]
        },
        "remote_contract_kind": {
          "anyOf": [{ "type": "string", "enum": ["a2a", "unknown"] }, { "type": "null" }]
        },
        "confidence": { "type": "number" },
        "rationale": { "type": "string" },
        "adk_hints": { "anyOf": [{ "$ref": "#/$defs/adkHints" }, { "type": "null" }] },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "reuse_candidate": { "type": "boolean" },
        "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
        "risk_signals": { "type": "array", "items": { "$ref": "#/$defs/riskSignal" } },
        "status": { "type": "string", "enum": ["needs_info", "deferred", "rejected"] },
        "missing_information": { "type": "array", "items": { "type": "string" } },
        "missing_information_resolution": { "type": "string" },
        "resolved_missing_information": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resolution_draft": {
          "anyOf": [{ "$ref": "#/$defs/resolutionDraft" }, { "type": "null" }]
        },
        "resolution_applied_at": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "schema_review_state": {
          "type": "string",
          "enum": ["not_started", "drafted", "applied"]
        },
        "smoke_spec": {
          "anyOf": [{ "$ref": "#/$defs/smokeSpec" }, { "type": "null" }]
        },
        "side_effect": {
          "anyOf": [{ "type": "string", "enum": ["none", "read", "write", "read_write", "unknown"] }, { "type": "null" }]
        },
        "owner_domain": { "$ref": "#/$defs/nullableString" },
        "developer_todos": { "type": "array", "items": { "type": "string" } },
        "a2a_contract_id": { "$ref": "#/$defs/nullableString" }
      }
    },
    "a2aContractDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "remote_module_id", "target_agent_name", "target_agent_purpose"],
      "properties": {
        "contract_id": { "$ref": "#/$defs/nullableString" },
        "remote_module_id": { "$ref": "#/$defs/nullableString" },
        "target_agent_name": { "$ref": "#/$defs/nullableString" },
        "target_agent_purpose": { "$ref": "#/$defs/nullableString" }
      }
    },
    "processFlowDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "graph_id", "root_workflow_module_id", "nodes", "edges", "containers", "lanes", "validation"],
      "properties": {
        "requirement_id": { "type": "string" },
        "graph_id": { "type": "string" },
        "root_workflow_module_id": { "$ref": "#/$defs/nullableString" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/graphNodeDraft" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/graphEdgeDraft" } },
        "containers": { "type": "array", "items": { "$ref": "#/$defs/graphContainerDraft" } },
        "lanes": { "type": "array", "items": { "$ref": "#/$defs/graphLaneDraft" } },
        "validation": { "$ref": "#/$defs/graphValidationDraft" }
      }
    },
    "graphNodeDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module_id",
        "label",
        "node_kind",
        "execution_kind",
        "agent_execution_mode",
        "adk_node_role",
        "owner_scope",
        "container_id",
        "lane_id",
        "schema_refs",
        "review_status",
        "workflow_ref",
        "input_schema",
        "output_schema",
        "input_mapping",
        "output_mapping",
        "runtime_binding",
        "mock_binding",
        "adk_skeleton_contract"
      ],
      "properties": {
        "id": { "type": "string" },
        "module_id": { "$ref": "#/$defs/nullableString" },
        "label": { "type": "string" },
        "node_kind": {
          "type": "string",
          "enum": [
            "input",
            "output",
            "agent",
            "function",
            "tool",
            "adapter",
            "adapter_call",
            "human_input",
            "workflow",
            "workflow_call",
            "remote_a2a",
            "remote_agent_call",
            "join",
            "router",
            "loop_control"
          ]
        },
        "execution_kind": { "$ref": "#/$defs/nullableString" },
        "agent_execution_mode": { "$ref": "#/$defs/agentExecutionMode" },
        "adk_node_role": {
          "anyOf": [
            { "type": "string", "enum": ["workflow_node", "container_root", "boundary", "synthetic"] },
            { "type": "null" }
          ]
        },
        "owner_scope": { "type": "string", "enum": ["local", "remote", "external"] },
        "container_id": {
          "anyOf": [{ "type": "string", "pattern": "^container-[a-z0-9-]+$" }, { "type": "null" }]
        },
        "lane_id": { "type": "string", "enum": ["input", "local_graph", "adapter", "human_input", "output", "remote_boundary"] },
        "schema_refs": { "type": "array", "items": { "type": "string" } },
        "review_status": { "type": "string", "enum": ["needs_info", "approved", "deferred", "rejected", "n/a"] },
        "workflow_ref": { "anyOf": [{ "$ref": "#/$defs/graphWorkflowRef" }, { "type": "null" }] },
        "input_schema": { "$ref": "#/$defs/nullableString" },
        "output_schema": { "$ref": "#/$defs/nullableString" },
        "input_mapping": { "anyOf": [{ "$ref": "#/$defs/stringMapping" }, { "type": "null" }] },
        "output_mapping": { "anyOf": [{ "$ref": "#/$defs/stringMapping" }, { "type": "null" }] },
        "runtime_binding": {
          "anyOf": [
            { "type": "string", "enum": ["unresolved", "direct_api", "mcp_tool", "local_function", "remote_a2a", "workflow_call", "ui_input"] },
            { "type": "null" }
          ]
        },
        "mock_binding": { "anyOf": [{ "$ref": "#/$defs/graphMockBinding" }, { "type": "null" }] },
        "adk_skeleton_contract": { "anyOf": [{ "$ref": "#/$defs/adkSkeletonContract" }, { "type": "null" }] }
      }
    },
    "graphWorkflowRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source", "display_name"],
      "properties": {
        "id": { "type": "string" },
        "version": { "$ref": "#/$defs/nullableString" },
        "source": { "type": "string", "enum": ["catalog", "artifact", "placeholder"] },
        "display_name": { "type": "string" }
      }
    },
    "stringMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "graphMockBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "package_path", "mock_server_id", "tool_name", "input_schema", "output_schema", "sample_response_ref", "status"],
      "properties": {
        "provider": { "type": "string", "const": "mock_lab" },
        "package_path": { "type": "string", "const": "packages/mock-lab" },
        "mock_server_id": { "$ref": "#/$defs/nullableString" },
        "tool_name": { "$ref": "#/$defs/nullableString" },
        "input_schema": { "$ref": "#/$defs/nullableString" },
        "output_schema": { "$ref": "#/$defs/nullableString" },
        "sample_response_ref": { "$ref": "#/$defs/nullableString" },
        "status": { "type": "string", "enum": ["linked", "missing", "invalid"] }
      }
    },
    "adkSkeletonContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scaffold_level",
        "target_runtime",
        "entrypoint",
        "generation_mode",
        "implementation_template",
        "manual_completion_required",
        "developer_todos"
      ],
      "properties": {
        "scaffold_level": { "type": "string", "enum": ["none", "handoff", "mock_testable_skeleton", "manual_required"] },
        "target_runtime": { "type": "string", "enum": ["adk_python_2_x"] },
        "entrypoint": { "type": "string", "enum": ["root_agent"] },
        "generation_mode": { "type": "string", "enum": ["deterministic_template", "llm_assisted_patch", "manual"] },
        "implementation_template": { "type": "string" },
        "manual_completion_required": { "type": "boolean" },
        "developer_todos": { "type": "array", "items": { "type": "string" } }
      }
    },
    "graphEdgeDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "edge_kind",
        "execution_semantics",
        "data_label",
        "schema_ref",
        "route_condition",
        "state_key",
        "artifact_key",
        "a2a_contract_id",
        "is_remote_boundary_crossing"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^edge-[0-9]+$" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "edge_kind": {
          "type": "string",
          "enum": [
            "event_output",
            "event_message",
            "session_state",
            "temp_state",
            "user_state",
            "app_state",
            "artifact",
            "route",
            "control",
            "remote_a2a"
          ]
        },
        "execution_semantics": {
          "type": "string",
          "enum": ["normal_transition", "fan_out", "fan_in", "loop_back", "loop_exit", "conditional", "boundary_crossing"]
        },
        "data_label": { "type": "string" },
        "schema_ref": { "$ref": "#/$defs/nullableString" },
        "route_condition": { "$ref": "#/$defs/nullableString" },
        "state_key": { "$ref": "#/$defs/nullableString" },
        "artifact_key": { "$ref": "#/$defs/nullableString" },
        "a2a_contract_id": { "$ref": "#/$defs/nullableString" },
        "is_remote_boundary_crossing": { "type": "boolean" }
      }
    },
    "graphContainerDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module_id",
        "label",
        "container_kind",
        "adk_mapping",
        "contains_node_ids",
        "entry_node_ids",
        "exit_node_ids",
        "layout_policy",
        "parent_container_id"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^container-[a-z0-9-]+$" },
        "module_id": { "$ref": "#/$defs/nullableString" },
        "label": { "type": "string" },
        "container_kind": {
          "type": "string",
          "enum": ["graph_workflow", "dynamic_workflow", "parallel_region", "loop_region", "human_review_region", "remote_boundary"]
        },
        "adk_mapping": { "$ref": "#/$defs/nullableString" },
        "contains_node_ids": { "type": "array", "items": { "type": "string" } },
        "entry_node_ids": { "type": "array", "items": { "type": "string" } },
        "exit_node_ids": { "type": "array", "items": { "type": "string" } },
        "layout_policy": { "type": "string", "enum": ["dag_with_routes", "fan_out_fan_in", "loop", "linear", "free"] },
        "parent_container_id": {
          "anyOf": [{ "type": "string", "pattern": "^container-[a-z0-9-]+$" }, { "type": "null" }]
        }
      }
    },
    "graphLaneDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "enum": ["input", "local_graph", "adapter", "human_input", "output", "remote_boundary"] },
        "label": { "type": "string" }
      }
    },
    "graphValidationDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "errors", "warnings"],
      "properties": {
        "ok": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
