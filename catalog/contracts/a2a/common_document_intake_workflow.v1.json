{
  "contract_id": "a2a-101",
  "remote_module_id": "catalog-workflow-common_document_intake_workflow",
  "target_agent_name": "Common Document Intake Workflow",
  "target_agent_purpose": "Receive a synthetic document package, extract text, retrieve policy references, and return a standard document context.",
  "contract_status": "approved",
  "agent_card": {
    "discovery_method": "catalog fixture registry",
    "agent_card_url": "fixture://agent-cards/common-document-intake-workflow.v1.json",
    "version": "1.0.0",
    "notes": "Synthetic Agent Card for local workbench fixture validation only."
  },
  "supported_interfaces": [
    {
      "url": "fixture://a2a/common-document-intake",
      "protocol_binding": "HTTP+JSON",
      "protocol_version": "A2A 1.0",
      "tenant_policy": "single synthetic tenant"
    }
  ],
  "input_modes": ["application/json"],
  "output_modes": ["application/json"],
  "security_schemes": [
    {
      "name": "fixtureServiceToken",
      "scheme": "bearer"
    }
  ],
  "security_requirements": [
    {
      "scheme_name": "fixtureServiceToken",
      "scopes": ["document.intake.synthetic"]
    }
  ],
  "skills": ["document_intake", "ocr_context", "policy_context"],
  "extensions": [],
  "message_contract": {
    "allowed_part_fields": ["text", "data"],
    "allowed_roles": ["ROLE_USER", "ROLE_AGENT"]
  },
  "task_lifecycle": {
    "states": [
      "TASK_STATE_SUBMITTED",
      "TASK_STATE_WORKING",
      "TASK_STATE_INPUT_REQUIRED",
      "TASK_STATE_AUTH_REQUIRED",
      "TASK_STATE_COMPLETED",
      "TASK_STATE_FAILED",
      "TASK_STATE_CANCELED",
      "TASK_STATE_REJECTED"
    ],
    "terminal_states": [
      "TASK_STATE_COMPLETED",
      "TASK_STATE_FAILED",
      "TASK_STATE_CANCELED",
      "TASK_STATE_REJECTED"
    ],
    "notes": "The fixture emits a task wrapper first, optional taskStatusUpdate wrappers, and a taskArtifactUpdate wrapper for document_context."
  },
  "streaming": {
    "supported": true,
    "wrappers": ["task", "message", "taskStatusUpdate", "taskArtifactUpdate"]
  },
  "operations": ["SendMessage", "SendStreamingMessage", "GetTask", "SubscribeToTask", "CancelTask"],
  "http_paths": ["/message:send", "/message:stream", "/tasks/{id}", "/tasks/{id}:subscribe", "/tasks/{id}:cancel"],
  "artifact_contract": {
    "artifact_name": "document_context",
    "parts": ["data"],
    "schema_ref": "catalog.banking.common_document_intake.document_context.v1"
  },
  "adk_host_mapping": "ADK graph workflow calls this as a reviewed remote runtime binding; generated source remains stub/TODO until runtime configuration is approved.",
  "timeout": "overall 45s, connect 5s",
  "retry": "max 1 retry for transient fixture transport errors",
  "fallback": "return intake_warnings and route to local human review",
  "cancellation": "client may cancel by task id before terminal state",
  "unsupported_operation": "return UnsupportedOperationError for operations outside the declared list",
  "get_task_fallback": "poll fixture task state through GetTask when stream is unavailable",
  "push_notification_policy": null,
  "auth": "fixture bearer token only; no production credential",
  "token_handling": "token is synthetic and never persisted in catalog data",
  "audit": "record fixture task id, synthetic document ids, state transitions, and artifact summary",
  "data_policy": "synthetic payloads only; no private banking data or customer identifiers",
  "success_task_example": {
    "task": {
      "id": "task-doc-intake-001",
      "contextId": "ctx-doc-intake-001",
      "status": {
        "state": "TASK_STATE_COMPLETED"
      },
      "artifacts": [
        {
          "artifactId": "artifact-document-context-001",
          "name": "document_context",
          "parts": [
            {
              "data": {
                "document_context": {
                  "document_ids": ["doc-fixture-001"],
                  "policy_citations": ["guide-loan-docs#2.1"]
                }
              }
            }
          ]
        }
      ]
    }
  },
  "auth_required_example": {
    "task": {
      "id": "task-doc-intake-auth",
      "contextId": "ctx-doc-intake-auth",
      "status": {
        "state": "TASK_STATE_AUTH_REQUIRED"
      }
    }
  },
  "failed_task_example": {
    "task": {
      "id": "task-doc-intake-error",
      "contextId": "ctx-doc-intake-error",
      "status": {
        "state": "TASK_STATE_FAILED"
      }
    }
  }
}
