          "readonly": true,
          "tables": [
            "synthetic_page_events"
          ],
          "sql_hash": "synthetic-sql-hash-001"
        },
        "runtime_mcp_label": "런타임 MCP",
        "runtime_mcp_note": "이 데이터는 page-analysis-mcp 서버의 execute_page_customer_sql tool을 실제 런타임 MCP로 호출해 받은 structuredContent입니다."
