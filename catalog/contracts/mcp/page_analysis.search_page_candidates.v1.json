{
  "schema_ref": "catalog.page_analysis.search_page_candidates.v1",
  "server": "page-analysis-mcp",
  "tool": "search_page_candidates",
  "title": "Page candidate RAG retrieval",
  "description": "Synthetic retrieval contract for selecting page candidates from user intent and customer behavior classification.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "query",
      "scenario_design_purpose",
      "scenario_target_business_domain",
      "customer_behavior_classification"
    ],
    "properties": {
      "query": { "type": "string" },
      "scenario_design_purpose": { "type": "string" },
      "scenario_target_business_domain": { "type": "string" },
      "customer_behavior_classification": { "type": "object" },
      "top_k": { "type": "integer" }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "synthetic",
      "source",
      "page_candidates",
      "retrieval_metadata"
    ],
    "properties": {
      "synthetic": { "type": "boolean" },
      "source": { "type": "string" },
      "page_candidates": {
        "type": "array",
        "items": { "type": "object" }
      },
      "retrieval_metadata": { "type": "object" }
    }
  },
  "success_examples": [
    {
      "name": "savings_auto_transfer_candidates",
      "arguments": {
        "query": "적금 자동이체 설정 이탈 페이지",
