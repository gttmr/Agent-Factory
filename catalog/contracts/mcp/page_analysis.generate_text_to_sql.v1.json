        "recommendation_rationale": "자동이체 설정 전환율 개선 의도와 가장 직접적으로 연결된 페이지입니다."
      },
      "structuredContent": {
        "synthetic": true,
        "source": "agent-factory-mock-lab",
        "sql_text": "SELECT page_id, COUNT(*) AS visits, AVG(completion_rate) AS completion_rate FROM synthetic_page_events WHERE page_id = 'svc-savings-auto-transfer-setup' GROUP BY page_id",
