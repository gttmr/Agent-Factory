{
  "schema_ref": "catalog.banking.rule_registry.evaluate_rule_set.v1",
  "server": "banking-rule-registry-mcp",
  "tool": "evaluate_rule_set",
  "title": "Banking rule registry evaluation",
  "description": "Synthetic contract for deterministic rule-set evaluation in catalog fixture smoke tests.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["rule_set_key", "case_features"],
    "properties": {
      "rule_set_key": { "type": "string" },
      "case_features": { "type": "object" },
      "evaluation_date": { "type": "string" }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["rule_result", "matched_rules", "required_actions"],
    "properties": {
      "rule_result": { "type": "object" },
      "matched_rules": {
        "type": "array",
        "items": { "type": "object" }
      },
      "required_actions": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  },
  "success_examples": [
    {
      "name": "loan_precheck_rules",
      "arguments": {
        "rule_set_key": "loan_precheck_v1",
        "case_features": {
          "document_context_ready": true,
          "risk_signal_count": 2
        },
        "evaluation_date": "2026-05-14"
      },
      "structuredContent": {
        "rule_result": {
          "decision": "manual_review_required",
          "score_band": "medium"
        },
        "matched_rules": [
          { "rule_id": "loan-precheck-r001", "outcome": "manual_review_required" }
        ],
        "required_actions": ["review_missing_documents", "record_audit_note"]
      }
    }
  ],
  "error_examples": [
    {
      "name": "unknown_rule_set",
      "arguments": {
        "rule_set_key": "unknown",
        "case_features": {}
      },
      "isError": true,
      "message": "rule_set_key is not registered"
    }
  ],
  "mock_response": {
    "content": [
      {
        "type": "text",
        "text": "{\"decision\":\"manual_review_required\"}"
      }
    ],
    "structuredContent": {
      "rule_result": {
        "decision": "manual_review_required",
        "score_band": "medium"
      },
      "matched_rules": [
        { "rule_id": "loan-precheck-r001", "outcome": "manual_review_required" }
      ],
      "required_actions": ["review_missing_documents", "record_audit_note"]
    },
    "isError": false
  }
}
