    "id": "req-001",
    "title": "Graph workflow with parallel evidence lookup and human review",
    "raw_text": "We need a graph-shaped workflow that takes intake, runs evidence lookups in parallel, scores risk on the merged evidence, sends high-risk cases to a human reviewer, and finally drafts the response. Low-risk cases skip the reviewer step. The workflow is local; there is no independent remote agent in the picture.",
    "domain": "customer-service",
    "requester": {
      "team": "support-operations",
      "role": "business-user"
    },
    "business_goal": "Run intake, parallel evidence lookup, risk scoring, optional human review, and response drafting as one orchestrated graph.",
    "current_process": [
      "Receive the intake request",
      "Run evidence lookups in parallel",
      "Merge the parallel evidence",
      "Score the risk on merged evidence",
      "Route high-risk cases to a human reviewer",
      "Draft the final response"
    ],
    "inputs": [
      { "name": "intake_request", "type": "object", "required": true }
    ],
    "outputs": [
      { "name": "drafted_response", "type": "text", "required": true }
    ],
    "systems": [
      { "name": "evidence_source_a", "access": "read" },
      { "name": "evidence_source_b", "access": "read" }
    ],
    "risk_signals": ["customer_impact", "human_approval_required", "audit_required"],
    "missing_information": [
      "risk threshold for human review",
      "merge policy for parallel evidence"
    ],
    "contradictions": [],
    "status": "draft"
  },
